{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://test-data-lab.local/schemas/entity-operation-matrix/v1",
  "title": "Test Data Lab entity operation matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "matrixVersion", "status", "asOfDate", "evidenceStatus", "sourceIds", "lifecycles", "limitations"],
  "properties": {
    "$schema": { "const": "./entity-operation-matrix.schema.v1.json" },
    "matrixVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["discovery", "review", "approved", "retired"] },
    "asOfDate": { "type": "string", "format": "date" },
    "evidenceStatus": { "const": "documented" },
    "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
    "lifecycles": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/lifecycle" }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "classification": { "enum": ["unknown", "supported", "conditional", "unsupported", "not-documented"] },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "create", "update", "delete", "void"],
      "properties": {
        "read": { "$ref": "#/$defs/classification" },
        "create": { "$ref": "#/$defs/classification" },
        "update": { "$ref": "#/$defs/classification" },
        "delete": { "$ref": "#/$defs/classification" },
        "void": { "$ref": "#/$defs/classification" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "operations", "sourceIds", "notes"],
      "properties": {
        "entity": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
        "operations": { "$ref": "#/$defs/operations" },
        "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityKey", "entities"],
      "properties": {
        "capabilityKey": { "$ref": "#/$defs/key" },
        "entities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entity" } }
      }
    }
  }
}
