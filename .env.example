PORT=3001
APP_HOST=127.0.0.1
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
MONGODB_URI=mongodb://localhost:27017/qbo-support-lab
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Configure a private value generated from at least 32 random bytes; startup refuses a missing/public key.
JWT_SECRET=
JWT_EXPIRES_IN=7d
QBO_CLIENT_ID=your-client-id-here
QBO_CLIENT_SECRET=your-client-secret-here
QBO_REDIRECT_URI=http://localhost:3001/api/qbo/callback
QBO_ENVIRONMENT=sandbox
QBO_REALM_ID=your-realm-id-here
ANTHROPIC_API_KEY=your-anthropic-key-here
AI_MODEL_FAST=claude-sonnet-4-6
AI_MODEL_DEEP=claude-opus-4-6
AI_MAX_TOKENS=4096
AI_MAX_TOOL_ROUNDS=10
AI_GLOBAL_KEY_ENABLED=false
AI_USER_KEYS_ENABLED=true
# auto = Codex CLI (ChatGPT subscription) when installed and signed in, else Anthropic key
AI_PROVIDER=auto
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=300000
# CODEX_CLI_PATH=C:\path\to\codex.exe
REBUILD_READ_ONLY_ENABLED=true
LEGACY_AI_MUTATIONS_ENABLED=false
LEGACY_ISSUEPACK_MUTATIONS_ENABLED=false
LEGACY_STARTUP_MAINTENANCE_ENABLED=false
