{
  "name": "test-data-lab",
  "version": "0.0.1",
  "private": true,
  "description": "Local control and visibility app for a realistic, continually evolving QuickBooks Online test company",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev-launcher.js",
    "dev:check": "node scripts/dev-launcher.js --check",
    "dev:preview": "node scripts/dev-launcher.js --preview",
    "dev:raw": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend -- --strictPort",
    "test:launcher": "node --test scripts/dev-launcher.test.js",
    "test:backend": "npm run test --workspace=backend",
    "render:discovery": "node scripts/render-discovery-catalog.js",
    "validate:discovery": "node scripts/validate-discovery-catalog.js",
    "validate:design": "node scripts/validate-rebuild-design.js",
    "validate:design:contrast": "node scripts/validate-rebuild-contrast.js",
    "verify:design:browser": "node scripts/audit-rebuild-design.js",
    "connect": "node scripts/phase-0/01-connect-company.js",
    "seed": "node scripts/phase-0/02-seed-master-data.js",
    "ar-chain": "node scripts/phase-0/03-create-ar-chain.js",
    "ap-chain": "node scripts/phase-0/04-create-ap-chain.js",
    "read-chains": "node scripts/phase-0/05-read-transaction-chain.js",
    "rate-limits": "node scripts/phase-0/06-exercise-rate-limits.js",
    "sales-order": "node scripts/phase-0/07-validate-sales-order.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "intuit-oauth": "^4.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright-core": "^1.62.1"
  }
}
